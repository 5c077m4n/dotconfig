{
	"$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
	"permission": {
		"*": "allow",
		"path": {
			"*": "allow",
			"*.env": "deny",
			"*.env.*": "deny",
			"*.env.example": "allow"
		},
		"bash": {
			"*": "allow",
			"ls *": "allow",
			"rg *": "allow",
			"grep *": "allow",
			"sudo *": "ask",
			"rm *": "allow",
			"rm -r *": "deny",
			"rm -rf *": "deny",
			"rm --recursive *": "deny"
		},
		"external_directory": "deny"
	}
}
